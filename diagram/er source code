Table users {
  user_id int [pk, increment]
  name varchar(100) [not null]
  email varchar(150) [unique, not null]
  password varchar(255) [not null]
  phone varchar(15)
  role varchar(30) [not null, note: 'CITIZEN, OFFICER, ADMIN']
  city varchar(100)
  created_at datetime
}

Table departments {
  department_id int [pk, increment]
  department_name varchar(100) [not null]
  description varchar(255)
  contact_number varchar(15)
}

Table officers {
  officer_id int [pk, increment]
  user_id int [not null, unique]
  department_id int [not null]
  designation varchar(100)
  status varchar(30) [note: 'ACTIVE, INACTIVE']
}

Table issues {
  issue_id int [pk, increment]
  user_id int [not null]
  department_id int
  title varchar(200) [not null]
  description text [not null]
  issue_type varchar(100) [not null]
  location varchar(255) [not null]
  latitude decimal(10,7)
  longitude decimal(10,7)
  priority varchar(30) [note: 'LOW, MEDIUM, HIGH, EMERGENCY']
  status varchar(30) [not null, note: 'REPORTED, ASSIGNED, IN_PROGRESS, RESOLVED, REJECTED']
  created_at datetime
  updated_at datetime
}

Table issue_images {
  image_id int [pk, increment]
  issue_id int [not null]
  image_url varchar(500) [not null]
  uploaded_at datetime
}

Table issue_assignments {
  assignment_id int [pk, increment]
  issue_id int [not null]
  officer_id int [not null]
  assigned_at datetime
  completed_at datetime
  status varchar(30) [note: 'ASSIGNED, IN_PROGRESS, COMPLETED']
}

Table issue_updates {
  update_id int [pk, increment]
  issue_id int [not null]
  officer_id int
  status varchar(30) [not null]
  remarks text
  updated_at datetime
}

Table comments {
  comment_id int [pk, increment]
  issue_id int [not null]
  user_id int [not null]
  comment text [not null]
  created_at datetime
}

Table notifications {
  notification_id int [pk, increment]
  user_id int [not null]
  issue_id int
  message varchar(500) [not null]
  notification_type varchar(50)
  is_read boolean [default: false]
  created_at datetime
}

Table admin_actions {
  action_id int [pk, increment]
  admin_id int [not null]
  issue_id int
  action varchar(100) [not null]
  remarks text
  created_at datetime
}


// Relationships

Ref: officers.user_id - users.user_id

Ref: officers.department_id > departments.department_id

Ref: issues.user_id > users.user_id

Ref: issues.department_id > departments.department_id

Ref: issue_images.issue_id > issues.issue_id

Ref: issue_assignments.issue_id > issues.issue_id

Ref: issue_assignments.officer_id > officers.officer_id

Ref: issue_updates.issue_id > issues.issue_id

Ref: issue_updates.officer_id > officers.officer_id

Ref: comments.issue_id > issues.issue_id

Ref: comments.user_id > users.user_id

Ref: notifications.user_id > users.user_id

Ref: notifications.issue_id > issues.issue_id

Ref: admin_actions.admin_id > users.user_id

Ref: admin_actions.issue_id > issues.issue_id